{
  "name": "miaob-extension",
  "version": "0.6.22",
  "description": "妙笔 - 中文网页阅读增强 Chrome 扩展",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));const m=JSON.parse(fs.readFileSync('manifest.json'));m.version=p.version;fs.writeFileSync('manifest.json',JSON.stringify(m,null,2)+'\\n');console.log('manifest version synced to',p.version)\"",
    "build": "npm run sync-version && tsc && vite build && node scripts/build-content.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@crxjs/vite-plugin",
      "esbuild"
    ]
  }
}
